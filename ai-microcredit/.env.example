# Copy to .env.local. Match the password in compose.yaml; URL-encode special characters.
DATABASE_URL=postgresql://credit_user:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5433/credit_app
# Open the app using this exact origin. HTTPS is required outside localhost.
APP_ORIGIN=http://localhost:3000
# Local demonstration accounts only; disable outside development.
ALLOW_DEMO_SEED=true
